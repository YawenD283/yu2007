)
outliers <- function(data) {
stats <- data %>%
summarise(
mean= mean(response_time, na.rm = TRUE),
sd = sd(response_time, na.rm = TRUE)
)
lower_bound <- stats$mean - (3 * stats$sd)
upper_bound <- stats$mean + (3 * stats$sd)
participant <- data %>%
group_by(ParticipantID) %>%
summarise(
avg = mean(response_time, na.rm = TRUE)
)
outliers <- participant %>%
filter(avg < lower_bound | avg > upper_bound) %>%
pull(ParticipantID)
return(outliers)
}
outliers1 <- outliers(cleaned_data1)
outliers2 <- outliers(cleaned_data2)
outliers3 <- outliers(cleaned_data3)
# Filter data for Condition 2
condition2_data <- combined_data %>% filter(Condition == "Condition2")
# Apply the outliers function to Condition 2 data
outliers <- outliers(condition2_data)
# Check if the participant with high response time is in the outliers list
high_response_time_participant <- "6735ejzfkd"  # Replace with the actual ParticipantID
excluded <- high_response_time_participant %in% outliers
print(excluded)  # TRUE if the participant should be excluded, FALSE otherwise
